{
  "name": "wechaty-getting-started",
  "version": "1.18.12",
  "description": "Wechaty conversational SDK getting start template & examples",
  "type": "module",
  "engines": {
    "node": ">=26",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc",
    "lint:biome": "biome lint examples tests",
    "lint:ts": "tsc --isolatedModules --noEmit",
    "lint": "npm run lint:biome && npm run lint:ts",
    "postinstall": "check-node-version --node \">=26\" --npm \">=10\"",
    "start": "node examples/ding-dong-bot.ts",
    "test": "npm run lint && npm run test:smoke",
    "test:smoke": "node --test --test-force-exit --test-timeout=180000 tests",
    "test:unit:deno": "env -i PATH=\"$PATH\" HOME=\"$HOME\" CI=\"${CI:-}\" NODE_BINARY=\"${NODE_BINARY:-$(command -v node)}\" deno test --no-check --allow-read --allow-write --allow-env --allow-net --allow-run --allow-sys --allow-ffi=node_modules/leveldown/prebuilds tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wechaty/getting-started.git"
  },
  "keywords": [],
  "author": "Huan LI <zixia@zixia.net>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/wechaty/getting-started/issues"
  },
  "homepage": "https://github.com/wechaty/getting-started#readme",
  "dependencies": {
    "dotenv": "^18.0.10",
    "qrcode-terminal": "^0.12.0",
    "wechaty": ">=2.0.0-0 <3",
    "wechaty-plugin-contrib": "^1.12.2",
    "wechaty-puppet-neo": "^0.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "check-node-version": "^4.2.1",
    "wechaty-puppet-mock": "^1.19.4"
  }
}
