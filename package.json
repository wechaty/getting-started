{
  "name": "wechaty-getting-started",
  "version": "1.18.12",
  "description": "Wechaty conversational SDK getting start template & examples",
  "type": "module",
  "engines": {
    "node": ">=26",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "postinstall": "check-node-version --node \">=26\" --npm \">=10\"",
    "start": "node examples/ding-dong-bot.ts",
    "start:js": "node examples/basic/ding-dong-bot.js",
    "test": "npm-run-all lint test:smoke",
    "test:smoke": "tap --timeout=150 \"tests/**/*.spec.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wechaty/getting-started.git"
  },
  "keywords": [],
  "author": "Huan LI <zixia@zixia.net>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/wechaty/getting-started/issues"
  },
  "homepage": "https://github.com/wechaty/getting-started#readme",
  "dependencies": {
    "dotenv": "^18.0.10",
    "npm-run-all": "^4.1.5",
    "qrcode-terminal": "^0.12.0",
    "wechaty": ">=2.0.0-0 <3",
    "wechaty-plugin-contrib": "^1.12.2",
    "wechaty-puppet-neo": "^0.1.1"
  },
  "devDependencies": {
    "@chatie/eslint-config": "^1.4.1",
    "@chatie/git-scripts": "^0.6.2",
    "@types/qrcode-terminal": "^0.12.2",
    "check-node-version": "^4.2.1",
    "is-pr": "^2.0.0",
    "tap": "~16.3.10",
    "tstest": "^1.2.8",
    "typescript": "^7.0.2",
    "wechaty-puppet-mock": "^1.19.4"
  },
  "overrides": {
    "typescript": "^7.0.2"
  },
  "git": {
    "scripts": {
      "pre-push": "npx git-scripts-pre-push"
    }
  }
}
